// ─────────────────────────────────────────────────────────────────────────────
// Inventory (spare parts) rules — FOR REVIEW, NOT DEPLOYED.
//
// This is a fragment, not a complete ruleset. Deploying it on its own would
// REPLACE your existing Firestore rules. Merge the helper functions and the
// two `match` blocks below into your current rules (inside
// `match /databases/{database}/documents { ... }`), then deploy.
//
// Model (see lib/inventory/spare-parts.ts):
//   companies/{companyId}/spareParts/{partDocId}
//   companies/{companyId}/sparePartIds/{encodedPartIdKey}   // uniqueness claims
//
// Roles: admin | manager | user | mechanic   (users/{uid}.role)
//   - every member may read, add parts, and assign an in-stock part
//   - only admin / manager / user may edit, release (remove from vehicle),
//     scrap or delete parts
//
// Mechanics also need READ access to companies/{companyId}/vehicles and to
// lookup-lists/{companyId}/** (the app loads vehicles for the assign picker).
// Check your existing rules allow that for role "mechanic".
// ─────────────────────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMember(companyId) {
      return request.auth != null && companyId in userDoc().companies;
    }

    function canEditInventory(companyId) {
      return isMember(companyId)
        && userDoc().role in ['admin', 'manager', 'user'];
    }

    // Only the assignment fields change, and the part moves stock → vehicle.
    function isAssignOnly() {
      return resource.data.status == 'in_stock'
        && request.resource.data.status == 'assigned'
        && request.resource.data.vehicleId is string
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'vehicleId', 'assignedAt', 'assignedBy']);
    }

    match /companies/{companyId}/spareParts/{partDocId} {
      allow read: if isMember(companyId);

      // Anyone in the company may add a part, always into stock.
      allow create: if isMember(companyId)
        && request.resource.data.status == 'in_stock'
        && request.resource.data.vehicleId == null
        && request.resource.data.entityStatus == true
        && request.resource.data.createdBy == request.auth.uid;

      // Mechanics may only assign; everything else needs an editing role.
      allow update: if (isMember(companyId) && isAssignOnly())
        || canEditInventory(companyId);

      // Parts are soft-deleted (entityStatus = false) via update.
      allow delete: if false;
    }

    match /companies/{companyId}/sparePartIds/{key} {
      allow read: if isMember(companyId);
      // Claims are created with a new part (any member) …
      allow create: if isMember(companyId);
      // … and moved / released when a part is renamed or deleted.
      allow delete: if canEditInventory(companyId);
      allow update: if false;
    }
  }
}
