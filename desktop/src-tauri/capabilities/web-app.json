{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "web-app",
  "description": "Lets the hosted web app read the installed version and trigger an update check.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://stuttgart-three.vercel.app/*",
      "http://localhost:3000/*"
    ]
  },
  "permissions": [
    "core:app:allow-version",
    "allow-check-for-updates"
  ]
}